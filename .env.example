# Variable names only. Store populated production values in Railway's secret store.
ALCHEMY_API_KEY=

# Hosted MongoDB Atlas storage. Do not put a populated URI in this file.
MONGODB_URI=
GPTHEIST_MONGODB_DB=gptheist
ROBINHOOD_POLL_MS=1000

# Optional explicit endpoint list. The Alchemy endpoint should carry #nologs on
# the Free tier so month-scale event history uses Robinhood's archive RPC.
# ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-key#nologs,https://rpc.mainnet.chain.robinhood.com

# The wallet UI and trade-preparation endpoint stay disabled unless this is true.
LIVE_TRADING_ENABLED=false
TRADE_MAX_BUY_WEI=50000000000000000
TRADE_MAX_SLIPPAGE_BPS=300
TRADE_MAX_PRICE_IMPACT_BPS=500
TRADE_MAX_TOTAL_FEE_BPS=500
TRADE_MIN_BUY_SCORE=70
TRADE_MAX_QUOTE_AGE_BLOCKS=300

# Optional isolated ERC-4337 execution account. The treasury key remains in
# MetaMask; only this separate, time-limited session key is stored server-side.
# Generate a fresh 32-byte key and keep the populated value in Railway only.
ORCHESTRATOR_SESSION_PRIVATE_KEY=
SMART_ACCOUNT_SPEND_CAP_USD_CENTS=3000
SMART_ACCOUNT_MAX_GAS_UNITS=700000
SMART_ACCOUNT_MAX_FEE_PER_GAS_WEI=1000000000

# Set this to the exact deployed origin so signed login challenges are domain-bound.
# GPTHEIST_PUBLIC_ORIGIN=https://your-app.example
# The production start command resumes the stable MongoDB checkpoint automatically.
TRANSACTION_SYNC_ENABLED=true

# Hosted, forward-only paper account. This never signs or sends transactions.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_USD_MICROS=20000000
PAPER_DURATION_DAYS=30
PAPER_POLL_MS=60000
PAPER_POSITION_BPS=1000
PAPER_TAKE_PROFIT_BPS=5000
PAPER_STOP_LOSS_BPS=2000
PAPER_MAX_HOLD_MINUTES=1440
PAPER_MAX_TOTAL_FEE_BPS=500
PAPER_MAX_PRICE_IMPACT_BPS=500
PAPER_MODELED_SLIPPAGE_BPS=300
PAPER_MODELED_GAS_UNITS=350000

# AI provider secrets are read server-side only. Never expose these to desk.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
TOGETHER_API_KEY=
# TOGETHER_MODEL=provider/model-name
